# Copy to .env and replace every value before using this stack outside local development.
POSTGRES_DB=prestamos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-random-password
APP_DB_USER=prestamos_app
APP_DB_PASSWORD=replace-with-another-random-password
# Base64 of at least 32 random bytes, for example: openssl rand -base64 48
JWT_SECRET=replace-with-base64-encoded-32-plus-bytes
JWT_ISSUER=somosmakers-prestamos
CORS_ALLOWED_ORIGINS=http://localhost:4200,https://prueba.somosmakers.com
