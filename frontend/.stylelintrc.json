{
  "extends": ["stylelint-config-standard"],
  "ignoreFiles": ["dist/**", ".angular/**"],
  "rules": {
    "import-notation": "string",
    "at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": [
          "apply",
          "custom-variant",
          "plugin",
          "reference",
          "source",
          "theme",
          "utility",
          "variant"
        ]
      }
    ]
  }
}
